<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<connectionStrings>
		<add name="RealEstateDb"
			 connectionString="Server=(local);Database=RealEstateDb;Integrated Security=True;TrustServerCertificate=True;"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
	
	<appSettings>
		<add key="showLogin" value="false"/>
	</appSettings>
</configuration>